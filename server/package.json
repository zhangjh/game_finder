{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && node --import tsx scripts/apply-manual-sql.mjs",
    "db:seed": "node --import tsx scripts/seed.mjs",
    "import:gamepix": "node scripts/import-gamepix.mjs",
    "test:e2e": "node scripts/test-recommend-e2e.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@game-finder/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "node-cron": "^4.6.0",
    "openai": "^7.9.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
