# ===== 数据库（PostgreSQL + pgvector，见 docker-compose.yml）=====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/game_discovery

# ===== CORS：允许跨域调用本 API 的来源（逗号分隔）=====
# 前端主域（CF Pages）+ 本地开发
ALLOWED_ORIGINS=http://localhost:5173

# ===== AI（OpenAI SDK，游戏画像分析 + Intent 解析 + Embedding）=====
# 也支持任意 OpenAI 兼容网关：设置 OPENAI_BASE_URL 即可
OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 定时任务保护密钥（Cron 调用 /api/cron/* 时通过 ?secret= 或 header 携带）=====
CRON_SECRET=change-me-to-a-random-string

# ===== 管理后台密码（MVP 简单密码保护，无账号体系）=====
ADMIN_PASSWORD=change-me
