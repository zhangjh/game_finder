# ===== 数据库（PostgreSQL + pgvector，见 docker-compose.yml）=====
# postgres 只在自己 docker 内网，不对宿主机暴露端口。
# 宿主机脚本（db:migrate / seed / import）统一用一次性 docker run 容器连内网执行（见 docs/deployment-production.md）。
# 此处仅作参考；server 容器内的 DATABASE_URL 由 compose 硬编码为 @postgres:5432。
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/game_discovery

# ===== CORS：允许跨域调用本 API 的来源（逗号分隔）=====
# 前端主域（CF Pages）+ 本地开发
ALLOWED_ORIGINS=http://localhost:5173

# ===== AI（OpenAI SDK，游戏画像分析 + Intent 解析 + Embedding）=====
# 支持任意 OpenAI 兼容网关（如 DeepSeek、通义千问等）
AI_BASE_URL=https://api.openai.com/v1
AI_KEY=sk-xxx
MODEL_ID=gpt-4o-mini
# 向量模型（Embedding 独立于 Chat，走 EMBEDDING_* 配置）：
# 阿里云百炼 DashScope（OpenAI 兼容）：text-embedding-v4 支持 dimensions=1536（与 game_embeddings.embedding vector(1536) 匹配）
#   公共端点：EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   专属端点：EMBEDDING_BASE_URL=https://llm-xxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1（注意必须带 /compatible-mode/v1 路径）
#   EMBEDDING_API_KEY=sk-xxx（百炼/DashScope API Key）
#   EMBEDDING_MODEL=text-embedding-v4（模型需账号已开通，未开通会报 AccessDenied.Unpurchased）
# 三要素留空则 embedding 优雅跳过（保留 game_relations 结构化相似兜底，不影响主流程）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ===== 数据源：GamePix 商务分配的 site id（feeds.gamepix.com 的 sid 参数）=====
GAMEPIX_SID=7E317

# ===== 管理后台密码（MVP 简单密码保护，无账号体系）=====
ADMIN_PASSWORD=change-me
